# ── Idea generation (npm run ideas) ─────────────────────────────────────────────
# Without a key, use the no-API mode: npm run ideas:prompt → paste into Claude → npm run ideas:import
ANTHROPIC_API_KEY=
# Model used for ideas (and the critic unless ANTHROPIC_CRITIC_MODEL is set)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_CRITIC_MODEL=
# Thinking effort for generation: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Server-side refusal fallback ("default" routing). Set to "off" if your model/platform doesn't support it.
ANTHROPIC_FALLBACKS=default

# ── Rendering ──────────────────────────────────────────────────────────────────
# Only needed if Playwright's Chromium isn't installed (npx playwright install chromium)
CHROMIUM_PATH=
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ── Publishing (optional, OFF by default; see SETUP-INSTAGRAM.md) ─────────────
PUBLISHING_ENABLED=false
IG_USER_ID=
IG_ACCESS_TOKEN=
# graph.instagram.com (Instagram Login) or graph.facebook.com (Facebook Login for Business)
IG_API_HOST=graph.instagram.com
IG_GRAPH_VERSION=v26.0

# How the MP4 reaches Instagram: r2 | s3 | static | resumable
VIDEO_HOST=r2
# Public URL prefix where uploaded files are readable, e.g. https://pub-xxxx.r2.dev or https://media.example.com
PUBLIC_BASE_URL=
# Cloudflare R2 (S3-compatible). Endpoint is derived from the account id unless S3_ENDPOINT is set.
R2_ACCOUNT_ID=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: store the database elsewhere
# REELS_DB_PATH=data/reels.db
