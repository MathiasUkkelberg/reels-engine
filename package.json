    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "playwright": "1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "setup": "npx playwright install chromium && tsx src/cli.ts learn",
    "render": "tsx src/cli.ts render",
    "render:batch": "tsx src/cli.ts render:batch",
    "preview": "tsx src/cli.ts preview",
    "storyboard": "tsx src/cli.ts storyboard",
