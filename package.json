{
  "name": "reels-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Content pipeline for @0xclaudemaxxer: HTML/CSS/JS reel templates rendered to video, AI idea generation, and a learning loop.",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/inter": "^5.3.0",
