    "publish": "tsx src/cli.ts publish",
    "schedule": "tsx src/cli.ts schedule",
    "mark-posted": "tsx src/cli.ts mark-posted",
    "sync": "tsx src/cli.ts sync",
    "import:csv": "tsx src/cli.ts import:csv",
    "learn": "tsx src/cli.ts learn",
    "status": "tsx src/cli.ts status",
